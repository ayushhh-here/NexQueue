# Connect via a full Redis URL (e.g. Upstash, Redis Cloud, Railway, AWS ElastiCache):
# REDIS_URL=redis://default:password@127.0.0.1:6379

# Or connect via discrete host and port:
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=

# Optional SMTP configuration (defaults to free Ethereal test inbox):
# SMTP_HOST=smtp.ethereal.email
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
